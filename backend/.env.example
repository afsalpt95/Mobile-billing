# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Shop time zone for day boundaries and reports (hosted servers run in UTC)
SHOP_TIMEZONE=Asia/Kolkata

# Local MongoDB (never expose this to the frontend)
MONGODB_URI=mongodb://127.0.0.1:27017/mobile_shop_pos?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=mobile_shop_pos
# true  = refuse financial/stock postings when the server cannot run multi-document transactions (recommended)
# false = allow postings without transactions (development only - partial failures may leave data inconsistent)
MONGODB_REQUIRE_TRANSACTIONS=true

# Auth - replace with a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h
COOKIE_NAME=pos_token
COOKIE_SECURE=false

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Seed - development admin account
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
